<%- include('../layouts/header') %>

<div class="form-container">
    <h1>Cadastrar Produto</h1>

    <% if (erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>

    <form action="/produtos/cadastrar" method="POST">

        <div class="campo">
            <label>Nome <span class="obrigatorio">*</span></label>
            <input type="text" name="nome" required placeholder="Ex: Brigadeiro Gourmet">
        </div>

        <div class="campo">
            <label>Descrição</label>
            <textarea name="descricao" placeholder="Descrição do produto..."></textarea>
        </div>

        <div class="campo-linha">
            <div class="campo">
                <label>Preço (R$) <span class="obrigatorio">*</span></label>
                <input type="number" step="0.01" min="0" name="preco" required placeholder="0,00">
            </div>
            <div class="campo">
                <label>Estoque</label>
                <input type="number" min="0" name="estoque" value="0">
            </div>
        </div>

        <div class="campo">
            <label>Categoria <span class="obrigatorio">*</span></label>
            <select name="categoria" required>
                <option value="">Selecione...</option>
                <option value="Doces Finos">Doces Finos</option>
                <option value="Trufas">Trufas</option>
                <option value="Bolos">Bolos</option>
                <option value="Tortas">Tortas</option>
                <option value="Outros">Outros</option>
            </select>
        </div>

        <div class="campo">
            <label>URL da Imagem</label>
            <input type="text" name="imagem" placeholder="https://...">
        </div>

        <div class="botoes">
            <button type="submit" class="btn-primario">Salvar Produto</button>
            <a href="/produtos" class="btn-secundario">Cancelar</a>
        </div>

    </form>
</div>

<%- include('../layouts/footer') %>