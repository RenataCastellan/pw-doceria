<%- include('../layouts/header') %>

<div class="form-container">
    <h1>Editar Produto</h1>

    <% if (erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>

    <form action="/produtos/editar/<%= produto.id_produto %>" method="POST">

        <div class="campo">
            <label>Nome <span class="obrigatorio">*</span></label>
            <input type="text" name="nome" value="<%= produto.nome %>" required>
        </div>

        <div class="campo">
            <label>Descrição</label>
            <textarea name="descricao"><%= produto.descricao || '' %></textarea>
        </div>

        <div class="campo-linha">
            <div class="campo">
                <label>Preço (R$) <span class="obrigatorio">*</span></label>
                <input type="number" step="0.01" min="0" name="preco" value="<%= produto.preco %>" required>
            </div>
            <div class="campo">
                <label>Estoque</label>
                <input type="number" min="0" name="estoque" value="<%= produto.estoque %>">
            </div>
        </div>

        <div class="campo">
            <label>Categoria <span class="obrigatorio">*</span></label>
            <select name="categoria" required>
                <option value="">Selecione...</option>
                <% ['Doces Finos','Trufas','Bolos','Tortas','Outros'].forEach(cat => { %>
                    <option value="<%= cat %>" <%= produto.categoria === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <div class="campo">
            <label>URL da Imagem</label>
            <input type="text" name="imagem" value="<%= produto.imagem || '' %>">
        </div>

        <div class="campo checkbox">
            <label>
                <input type="checkbox" name="ativo" <%= produto.ativo ? 'checked' : '' %>>
                Produto ativo (visível no cardápio)
            </label>
        </div>

        <div class="botoes">
            <button type="submit" class="btn-primario">Atualizar Produto</button>
            <a href="/produtos" class="btn-secundario">Cancelar</a>
        </div>

    </form>
</div>

<%- include('../layouts/footer') %>