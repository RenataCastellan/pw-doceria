<%- include('../layouts/header') %>

<h1>Editar Produto</h1>

<form action="/produtos/editar/<%= produto.id %>" method="POST">

    <label>Nome do Produto</label>
    <br>
    <input
        type="text"
        name="nome"
        value="<%= produto.nome %>"
        required
    >
    <br><br>

    <label>Descrição</label>
    <br>
    <textarea name="descricao"><%= produto.descricao %></textarea>
    <br><br>

    <label>Preço</label>
    <br>
    <input
        type="number"
        step="0.01"
        name="preco"
        value="<%= produto.preco %>"
        required
    >
    <br><br>

    <button type="submit">
        Atualizar Produto
    </button>

</form>

<%- include('../layouts/footer') %>