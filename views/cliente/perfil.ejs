<%- include('../layouts/header') %>

<div class="form-container">
    <h1>Meu Perfil</h1>

    <div class="perfil-info">
        <p><strong>Nome:</strong> <%= cliente.nome %></p>
        <p><strong>E-mail:</strong> <%= cliente.email %></p>
        <p><strong>Membro desde:</strong> <%= new Date(cliente.created_at).toLocaleDateString('pt-BR') %></p>
        <p><strong>Total de pedidos:</strong> <%= cliente.total_pedidos %></p>
    </div>

    <div class="botoes">
        <a href="/cardapio" class="btn-primario">Voltar ao Cardápio</a>
        <a href="/logout" class="btn-secundario">Sair</a>
    </div>
</div>

<%- include('../layouts/footer') %>