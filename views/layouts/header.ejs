<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encanto Doceria</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>
    <div class="logo">
        <a href="/"><img src="/imagens/logo.png" alt="Encanto Doceria" width="120"></a>
    </div>

    <nav>
        <a href="/cardapio">Cardápio</a>
        <a href="/sobre">Sobre</a>

        <% if (adminLogado) { %>
            <a href="/painel">Painel Admin</a>
            <a href="/produtos">Gerenciar Produtos</a>
            <a href="/logout">Sair</a>

        <% } else if (usuarioLogado) { %>
            <a href="/carrinho">
                🛒 Carrinho
                <% if (carrinho.length > 0) { %>
                    <span class="badge"><%= carrinho.length %></span>
                <% } %>
            </a>
            <a href="/cliente/perfil">Olá, <%= usuarioLogado.nome.split(' ')[0] %></a>
            <a href="/logout">Sair</a>

        <% } else { %>
            <a href="/login">Login</a>
            <a href="/cadastrar">Cadastrar</a>
        <% } %>
    </nav>
</header>

<main>