<%- include('../layouts/header') %>

<h1>Login</h1>

<form action="/login" method="POST">

    <label>E-mail</label>
    <br>
    <input type="email" name="email" required>

    <br><br>

    <label>Senha</label>
    <br>
    <input type="password" name="senha" required>

    <br><br>

    <button type="submit">
        Entrar
    </button>

</form>

